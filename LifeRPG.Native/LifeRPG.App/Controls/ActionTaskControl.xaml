<UserControl x:Class="LifeRPG.App.Controls.ActionTaskControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Loaded="ActionTaskControl_Loaded"
             PreviewMouseWheel="ActionTaskControl_PreviewMouseWheel">
    <UserControl.Resources>
        <Style x:Key="ActionTaskComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#21162C" />
            <Setter Property="Foreground" Value="#E8E1F2" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A2A4A" />
                                <Setter Property="Foreground" Value="#7CFF6B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#4B2D68" />
                                <Setter Property="Foreground" Value="#7CFF6B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7A6A8A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#7A6A8A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionTaskComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="#140C1E" />
            <Setter Property="Foreground" Value="#E8E1F2" />
            <Setter Property="BorderBrush" Value="#5A3D73" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ActionTaskComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                      IsHitTestVisible="False">
                                        <ContentPresenter.Resources>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="#E8E1F2" />
                                            </Style>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>

                                    <ToggleButton Grid.Column="1"
                                                  Focusable="False"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="#B7A8C8"
                                                               Text="▼" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="#21162C"
                                        BorderBrush="#5A3D73"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer Margin="1"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Background" Value="#21162C" />
                                <Setter Property="Foreground" Value="#7A6A8A" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#7CFF6B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#7CFF6B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionTaskDatePickerTextBoxStyle" TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Background" Value="#140C1E" />
            <Setter Property="Foreground" Value="#E8E1F2" />
            <Setter Property="BorderBrush" Value="#5A3D73" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <Style x:Key="ActionTaskCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="Background" Value="#21162C" />
            <Setter Property="Foreground" Value="#E8E1F2" />
            <Setter Property="BorderBrush" Value="#3A2A4A" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A2A4A" />
                    <Setter Property="Foreground" Value="#7CFF6B" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#4B2D68" />
                    <Setter Property="Foreground" Value="#7CFF6B" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionTaskDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="#140C1E" />
            <Setter Property="Foreground" Value="#E8E1F2" />
            <Setter Property="BorderBrush" Value="#5A3D73" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CalendarStyle">
                <Setter.Value>
                    <Style TargetType="Calendar">
                        <Setter Property="Background" Value="#21162C" />
                        <Setter Property="Foreground" Value="#E8E1F2" />
                        <Setter Property="BorderBrush" Value="#5A3D73" />
                        <Setter Property="BorderThickness" Value="1.5" />
                        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ActionTaskCalendarDayButtonStyle}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#21162C"
            BorderBrush="#3A2A4A"
            BorderThickness="1.5"
            CornerRadius="12"
            Padding="22">
        <StackPanel>
            <TextBlock Text="行动任务"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#7CFF6B" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="#B7A8C8"
                       Text="用任务系统承接下一步行动，当前支持在完成任务时附带图片证据。"
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,18,0,0"
                       Foreground="#C8A45D"
                       FontSize="15"
                       FontWeight="Bold"
                       Text="新增行动任务" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="#B7A8C8" Text="任务标题" />
                    <TextBox x:Name="TaskTitleTextBox" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="#B7A8C8" Text="任务分类" />
                    <TextBox x:Name="TaskCategoryTextBox" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Foreground="#B7A8C8" Text="成长属性" />
                    <TextBox x:Name="TaskGrowthAttributeTextBox" Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Foreground="#B7A8C8" Text="四象限" />
                    <ComboBox x:Name="TaskQuadrantComboBox"
                              Style="{StaticResource ActionTaskComboBoxStyle}"
                              Margin="0,6,0,0"
                              SelectedIndex="1">
                        <ComboBoxItem Content="重要且紧急" Tag="ImportantUrgent" />
                        <ComboBoxItem Content="重要不紧急" Tag="ImportantNotUrgent" />
                        <ComboBoxItem Content="不重要但紧急" Tag="NotImportantUrgent" />
                        <ComboBoxItem Content="不重要不紧急" Tag="NotImportantNotUrgent" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Foreground="#B7A8C8" Text="任务内容" />
                    <TextBox x:Name="TaskContentTextBox"
                             Margin="0,6,0,0"
                             MinHeight="84"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="#B7A8C8" Text="截止日期" />
                    <DatePicker x:Name="TaskDueDatePicker"
                                Margin="0,6,0,0"
                                Style="{StaticResource ActionTaskDatePickerStyle}">
                        <DatePicker.Resources>
                            <Style TargetType="{x:Type primitives:DatePickerTextBox}"
                                   BasedOn="{StaticResource ActionTaskDatePickerTextBoxStyle}" />
                        </DatePicker.Resources>
                    </DatePicker>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Foreground="#B7A8C8" Text="截止时间 HH:mm" />
                    <TextBox x:Name="TaskDueTimeTextBox" Margin="0,6,0,0" />
                </StackPanel>
                <Button x:Name="CreateTaskButton"
                        Grid.Column="6"
                        Margin="0,24,0,0"
                        Height="42"
                        Click="CreateTaskButton_Click"
                        Content="新增任务" />
            </Grid>

            <Border Margin="0,18,0,0"
                    Background="#171020"
                    BorderBrush="#3A2A4A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="编辑当前任务"
                               Foreground="#C8A45D"
                               FontSize="15"
                               FontWeight="Bold" />
                    <TextBlock x:Name="EditTaskStatusTextBlock"
                               Margin="0,8,0,0"
                               Foreground="#B7A8C8"
                               Text="请选择一个任务进行编辑"
                               TextWrapping="Wrap" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#B7A8C8" Text="编辑标题" />
                            <TextBox x:Name="EditTaskTitleTextBox" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="#B7A8C8" Text="编辑分类" />
                            <TextBox x:Name="EditTaskCategoryTextBox" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Foreground="#B7A8C8" Text="编辑成长属性" />
                            <TextBox x:Name="EditTaskGrowthAttributeTextBox" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Foreground="#B7A8C8" Text="编辑四象限" />
                            <ComboBox x:Name="EditTaskQuadrantComboBox"
                                      Style="{StaticResource ActionTaskComboBoxStyle}"
                                      Margin="0,6,0,0"
                                      SelectedIndex="1">
                                <ComboBoxItem Content="重要且紧急" Tag="ImportantUrgent" />
                                <ComboBoxItem Content="重要不紧急" Tag="ImportantNotUrgent" />
                                <ComboBoxItem Content="不重要但紧急" Tag="NotImportantUrgent" />
                                <ComboBoxItem Content="不重要不紧急" Tag="NotImportantNotUrgent" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Foreground="#B7A8C8" Text="编辑内容" />
                            <TextBox x:Name="EditTaskContentTextBox"
                                     Margin="0,6,0,0"
                                     MinHeight="84"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Foreground="#B7A8C8" Text="编辑截止日期" />
                            <DatePicker x:Name="EditTaskDueDatePicker"
                                        Margin="0,6,0,0"
                                        Style="{StaticResource ActionTaskDatePickerStyle}">
                                <DatePicker.Resources>
                                    <Style TargetType="{x:Type primitives:DatePickerTextBox}"
                                           BasedOn="{StaticResource ActionTaskDatePickerTextBoxStyle}" />
                                </DatePicker.Resources>
                            </DatePicker>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Foreground="#B7A8C8" Text="编辑截止时间 HH:mm" />
                            <TextBox x:Name="EditTaskDueTimeTextBox" Margin="0,6,0,0" />
                        </StackPanel>
                        <WrapPanel Grid.Column="6" Margin="0,24,0,0">
                            <Button Width="100"
                                    Height="42"
                                    Click="SaveEditTaskButton_Click"
                                    Content="保存修改" />
                            <Button Margin="10,0,0,0"
                                    Width="100"
                                    Height="42"
                                    Click="CancelEditTaskButton_Click"
                                    Content="取消编辑" />
                        </WrapPanel>
                    </Grid>

                    <Border Margin="0,14,0,0"
                            Background="#21162C"
                            BorderBrush="#3A2A4A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Foreground="#C8A45D"
                                       FontWeight="Bold"
                                       Text="行为记录关联" />
                            <TextBlock x:Name="LinkedLifeRecordStatusTextBlock"
                                       Margin="0,8,0,0"
                                       Foreground="#B7A8C8"
                                       Text="关联行为记录：未关联"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="GenerateLifeRecordButton"
                                        Width="120"
                                        Height="38"
                                        Click="GenerateLifeRecordButton_Click"
                                        Content="生成行为记录" />
                                <Button x:Name="LinkExistingLifeRecordButton"
                                        Margin="10,0,0,0"
                                        Width="150"
                                        Height="38"
                                        Click="LinkExistingLifeRecordButton_Click"
                                        Content="关联已有行为记录" />
                                <Button x:Name="UnlinkLifeRecordButton"
                                        Margin="10,0,0,0"
                                        Width="100"
                                        Height="38"
                                        Click="UnlinkLifeRecordButton_Click"
                                        Content="取消关联" />
                                <Button x:Name="ViewLinkedLifeRecordButton"
                                        Margin="10,0,0,0"
                                        Width="100"
                                        Height="38"
                                        Click="ViewLinkedLifeRecordButton_Click"
                                        Content="查看行为记录" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Margin="0,18,0,0"
                    Background="#171020"
                    BorderBrush="#3A2A4A"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="完成任务"
                               Foreground="#C8A45D"
                               FontSize="15"
                               FontWeight="Bold" />
                    <TextBlock x:Name="CompleteTaskStatusTextBlock"
                               Margin="0,8,0,0"
                               Foreground="#B7A8C8"
                               Text="请选择一个任务进行完成"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,14,0,0"
                               Foreground="#B7A8C8"
                               Text="完成备注" />
                    <TextBox x:Name="CompletionNoteTextBox"
                             Margin="0,6,0,0"
                             MinHeight="84"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <Border Margin="0,14,0,0"
                            Background="#21162C"
                            BorderBrush="#3A2A4A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Foreground="#C8A45D"
                                       FontWeight="Bold"
                                       Text="待上传图片" />
                            <TextBlock x:Name="PendingTaskImagesCountTextBlock"
                                       Margin="0,8,0,0"
                                       Foreground="#B7A8C8"
                                       Text="待上传图片：0 张" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Width="150"
                                        Height="38"
                                        Click="SelectCompletionImagesButton_Click"
                                        Content="选择完成证据图片" />
                                <Button Margin="10,0,0,0"
                                        Width="130"
                                        Height="38"
                                        Click="ClearPendingImagesButton_Click"
                                        Content="清空待上传图片" />
                            </WrapPanel>
                            <ListBox x:Name="PendingTaskImagesListBox"
                                     Margin="0,10,0,0"
                                     MinHeight="80"
                                     Background="#140C1E"
                                     BorderBrush="#3A2A4A"
                                     Foreground="#E8E1F2" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0"
                            Background="#21162C"
                            BorderBrush="#3A2A4A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left"
                                           Foreground="#C8A45D"
                                           FontWeight="Bold"
                                           Text="已关联图片证据" />
                                <TextBlock x:Name="AssociatedTaskImagesCountTextBlock"
                                           DockPanel.Dock="Right"
                                           Foreground="#B7A8C8"
                                           Text="已关联图片：0 张" />
                            </DockPanel>
                            <DataGrid x:Name="TaskImageEvidenceDataGrid"
                                      Margin="0,10,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      MinHeight="150"
                                      HeadersVisibility="Column"
                                      SelectionChanged="TaskImageEvidenceDataGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="原始文件名" Binding="{Binding OriginalFileName}" Width="2*" />
                                    <DataGridTextColumn Header="文件大小" Binding="{Binding FileSizeText}" Width="120" />
                                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtText}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Margin="0,14,0,0"
                                    Background="#171020"
                                    BorderBrush="#3A2A4A"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12">
                                <StackPanel>
                                    <TextBlock Foreground="#C8A45D"
                                               FontWeight="Bold"
                                               Text="图片预览" />
                                    <Border Margin="0,10,0,0"
                                            Background="#140C1E"
                                            BorderBrush="#3A2A4A"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10">
                                        <Grid>
                                            <Image x:Name="ActionTaskImagePreview"
                                                   Stretch="Uniform"
                                                   MaxHeight="260" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="SelectedActionTaskImageNameText"
                                               Margin="0,10,0,0"
                                               Foreground="#B7A8C8"
                                               Text="未选择图片"
                                               TextWrapping="Wrap" />
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="OpenSelectedActionTaskImageButton"
                                                Width="110"
                                                Height="38"
                                                Click="OpenSelectedActionTaskImageButton_Click"
                                                Content="打开原图" />
                                        <Button x:Name="ClearActionTaskImagePreviewButton"
                                                Margin="10,0,0,0"
                                                Width="110"
                                                Height="38"
                                                Click="ClearActionTaskImagePreviewButton_Click"
                                                Content="清空预览" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Button Margin="0,10,0,0"
                                    Width="120"
                                    Height="38"
                                    HorizontalAlignment="Left"
                                    Click="OpenTaskImageFolderButton_Click"
                                    Content="打开图片目录" />
                            <Button Margin="10,10,0,0"
                                    Width="120"
                                    Height="38"
                                    HorizontalAlignment="Left"
                                    Background="#4A1C28"
                                    BorderBrush="#8A3348"
                                    Foreground="#F4D7DE"
                                    Click="DeleteSelectedTaskImageButton_Click"
                                    Content="删除选中图片" />
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Width="100"
                                Height="42"
                                Click="CompleteTaskButton_Click"
                                Content="完成任务" />
                        <Button Margin="10,0,0,0"
                                Width="120"
                                Height="42"
                                Click="ClearCompletionNoteButton_Click"
                                Content="清空完成备注" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Separator Margin="0,20,0,18" />

            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Width="100" Click="ShowTodayTasksButton_Click" Content="今日任务" />
                    <Button Margin="10,0,0,0" Width="100" Click="ShowOverdueTasksButton_Click" Content="逾期任务" />
                    <Button Margin="10,0,0,0" Width="100" Click="ShowAllTasksButton_Click" Content="全部任务" />
                    <Button Margin="10,0,0,0" Width="110" Click="ShowCompletedTasksButton_Click" Content="已完成任务" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="CurrentTaskViewTextBlock"
                               Margin="0,9,16,0"
                               Foreground="#C8A45D"
                               FontWeight="Bold"
                               Text="当前视图：全部任务" />
                    <TextBlock x:Name="TaskCountTextBlock"
                               Margin="0,9,0,0"
                               Foreground="#B7A8C8"
                               Text="当前显示 0 条任务" />
                </StackPanel>
            </DockPanel>

            <DataGrid x:Name="TaskDataGrid"
                      Margin="0,14,0,0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      MinHeight="220"
                      SelectionMode="Single"
                      SelectionChanged="TaskDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="120" />
                    <DataGridTextColumn Header="成长属性" Binding="{Binding GrowthAttribute}" Width="120" />
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100" />
                    <DataGridTextColumn Header="四象限" Binding="{Binding QuadrantText}" Width="130" />
                    <DataGridTextColumn Header="经验值" Binding="{Binding Experience}" Width="80" />
                    <DataGridTextColumn Header="截止时间" Binding="{Binding DueAtText}" Width="150" />
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtText}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>

            <WrapPanel Margin="0,14,0,0">
                <Button Width="120" Click="MarkNotStartedButton_Click" Content="标记为待开始" />
                <Button Margin="10,0,0,0" Width="120" Click="MarkInProgressButton_Click" Content="标记为进行中" />
                <Button Margin="10,0,0,0" Width="120" Click="MarkCompletedButton_Click" Content="标记为已完成" />
                <Button Margin="10,0,0,0" Width="120" Click="MarkCancelledButton_Click" Content="标记为已取消" />
                <Button Margin="10,0,0,0"
                        Width="100"
                        Background="#341317"
                        BorderBrush="#E35D5D"
                        Click="DeleteTaskButton_Click"
                        Content="删除任务" />
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
