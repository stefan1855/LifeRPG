<Window x:Class="LifeRPG.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LifeRPG.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Life RPG Native" Height="920" Width="1460"
        MinHeight="780" MinWidth="1260"
        WindowStartupLocation="CenterScreen"
        Background="#0A0F0D">

    <Window.Resources>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource WarlockTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="FieldValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#3A2552" />
            <Setter Property="BorderBrush" Value="{StaticResource WarlockSoulGreenBrush}" />
        </Style>

        <!-- ===== v6 贴图素材资源 ===== -->
        <!-- 面板边框九宫格画笔 -->
        <ImageBrush x:Key="PanelBorderBrush"
                    ImageSource="/Assets/Themes/UndeadWarlock/panel_border.png"
                    Stretch="Fill"
                    RenderOptions.BitmapScalingMode="Fant"/>

        <!-- 契约节点边框画笔 -->
        <ImageBrush x:Key="NodeBorderBrush"
                    ImageSource="/Assets/Themes/UndeadWarlock/node_border.png"
                    Stretch="UniformToFill"
                    RenderOptions.BitmapScalingMode="Fant"/>

        <!-- 邪能外发光效果 -->
        <DropShadowEffect x:Key="FelOuterGlow" BlurRadius="22" ShadowDepth="0" Color="#7CFC00" Opacity="0.55"/>

        <!-- 面板内部纹理画笔（可平铺） -->
        <ImageBrush x:Key="PanelInnerTexture"
                    ImageSource="/Assets/Themes/UndeadWarlock/panel_inner_texture.png"
                    TileMode="Tile" Viewport="0,0,256,256" ViewportUnits="Absolute"
                    Stretch="None"
                    RenderOptions.BitmapScalingMode="Fant"/>

        <!-- 邪能绿色文字样式（自带外发光） -->
        <Style x:Key="FelGreenGlowTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7CFC00"/>
            <Setter Property="Effect" Value="{StaticResource FelOuterGlow}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Assets/Themes/UndeadWarlock/global_background.png"
                        Stretch="UniformToFill" Opacity="0.3"
                        RenderOptions.BitmapScalingMode="Fant"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 四角恶魔头骨 -->
        <Image Source="/Assets/Themes/UndeadWarlock/corner_skull.png"
               Width="64" Height="64" Stretch="Uniform"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="8,8,0,0" Opacity="0.5" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image Source="/Assets/Themes/UndeadWarlock/corner_skull.png"
               Width="64" Height="64" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Top"
               Margin="0,8,8,0" Opacity="0.5" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image Source="/Assets/Themes/UndeadWarlock/corner_skull.png"
               Width="64" Height="64" Stretch="Uniform"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Margin="8,0,0,8" Opacity="0.5" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image Source="/Assets/Themes/UndeadWarlock/corner_skull.png"
               Width="64" Height="64" Stretch="Uniform"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,8,8" Opacity="0.5" RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- ===== 顶部标题栏 ===== -->
        <Grid Grid.Row="0">
            <Grid.Background>
                <ImageBrush ImageSource="/Assets/Themes/UndeadWarlock/banner_dark_iron.png"
                            Stretch="UniformToFill" Opacity="0.75"
                            RenderOptions.BitmapScalingMode="Fant"/>
            </Grid.Background>
            <TextBlock Text="✠ 角 色 仪 表 盘 ✠"
                       Foreground="#7CFC00" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource FelOuterGlow}"/>
            <Button x:Name="RefreshStatisticsButton"
                    Content="↻ 刷新数据"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,20,0" Padding="10,5"
                    Background="#1A2420" Foreground="#A0A0A0"
                    Click="RefreshStatisticsButton_Click"/>
        </Grid>

        <!-- ===== 主体：侧边栏 + 骨架布局 ===== -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 侧边导航栏（精简） -->
            <Border Grid.Column="0" CornerRadius="4"
                    BorderBrush="#2A3A32" BorderThickness="1"
                    Background="#0D1612" Width="46">
                <StackPanel Margin="4">
                    <Button x:Name="NavDashboard" Style="{StaticResource NavButtonActiveStyle}"
                            Width="34" Height="34" Margin="0,4" Padding="0"
                            FontSize="14" Content="⌂" ToolTip="首页"
                            Click="NavButton_Click" />
                    <Button x:Name="NavTasks" Style="{StaticResource NavButtonStyle}"
                            Width="34" Height="34" Margin="0,4" Padding="0"
                            FontSize="14" Content="⚔" ToolTip="行动任务"
                            Click="NavButton_Click" />
                    <Button x:Name="NavRecords" Style="{StaticResource NavButtonStyle}"
                            Width="34" Height="34" Margin="0,4" Padding="0"
                            FontSize="14" Content="📋" ToolTip="行为记录"
                            Click="NavButton_Click" />
                    <Button x:Name="NavAttributes" Style="{StaticResource NavButtonStyle}"
                            Width="34" Height="34" Margin="0,4" Padding="0"
                            FontSize="14" Content="📊" ToolTip="成长属性"
                            Click="NavButton_Click" />
                    <Button x:Name="NavImages" Style="{StaticResource NavButtonStyle}"
                            Width="34" Height="34" Margin="0,4" Padding="0"
                            FontSize="14" Content="🖼" ToolTip="图片证据"
                            Click="NavButton_Click" />
                    <Button x:Name="NavArchive" Style="{StaticResource NavButtonStyle}"
                            Width="34" Height="34" Margin="0,4" Padding="0"
                            FontSize="14" Content="📦" ToolTip="复盘归档"
                            Click="NavButton_Click" />
                    <Button x:Name="NavSettings" Style="{StaticResource NavButtonStyle}"
                            Width="34" Height="34" Margin="0,4" Padding="0"
                            FontSize="14" Content="⚙" ToolTip="设置"
                            Click="NavButton_Click" />
                </StackPanel>
            </Border>

            <!-- ===== 页面容器 ===== -->
            <Grid Grid.Column="2">

                <!-- ═══════════════ 首页：仪表盘 ═══════════════ -->
                <ScrollViewer x:Name="DashboardPage" Visibility="Visible"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid x:Name="BodyLayout" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="276"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="640"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="448"/>
                        </Grid.ColumnDefinitions>

                        <!-- ═══ 左栏：角色面板 ═══ -->
                        <Grid Grid.Column="0">
                            <!-- 阴影层 -->
                            <Border CornerRadius="6" Background="#0B1812" BorderBrush="#6B7A2A" BorderThickness="2"
                                    Effect="{StaticResource FelOuterGlow}">
                                <Border CornerRadius="5" BorderBrush="#1D2410" BorderThickness="1"/>
                            </Border>
                            <!-- 内容层 -->
                            <Border CornerRadius="5" Margin="2" Background="Transparent">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Rectangle Fill="{StaticResource PanelInnerTexture}" Opacity="1.0" Grid.RowSpan="3"/>

                                    <!-- 等级徽章 -->
                                    <Border Grid.Row="0" Background="#0D1A14" CornerRadius="4"
                                            HorizontalAlignment="Left" Margin="14,12,0,0" Padding="10,6"
                                            BorderBrush="#6B7A2A" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Lv." FontSize="10" Foreground="#7CFC00" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="DashboardLevelText" Text="27" FontSize="22" FontWeight="Bold"
                                                       Foreground="#7CFC00" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 人物立绘 -->
                                    <Image Grid.Row="1" Source="/Assets/Themes/UndeadWarlock/faceless_portrait.png"
                                           Stretch="UniformToFill" VerticalAlignment="Stretch"
                                           Margin="8,6,8,4" Opacity="0.92"
                                           RenderOptions.BitmapScalingMode="Fant"/>

                                    <!-- 底部信息 -->
                                    <StackPanel Grid.Row="2" Margin="14,0,14,12">
                                        <TextBlock x:Name="DashboardNameText" Text="无 面 者" FontSize="28" FontWeight="Bold"
                                                   Foreground="#D7EFC2" HorizontalAlignment="Center" Margin="0,2"/>
                                        <TextBlock x:Name="DashboardClassText" Text="☠ 暗 影 学 徒 ☠" FontSize="15"
                                                   Foreground="#7CFC00" HorizontalAlignment="Center" Margin="0,4"
                                                   Effect="{StaticResource FelOuterGlow}"/>
                                        <TextBlock x:Name="DashboardQuoteText"
                                                   Text="&#x201c;在阴影中行走，聆听灵魂的低语...&#x201d;"
                                                   FontSize="11" Foreground="#7F8B75" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8"/>
                                        <UniformGrid Columns="2" Margin="0,6">
                                            <Button Content="选择头像" Margin="2" Padding="6,4"
                                                    Background="#0D1A14" Foreground="#B7C7A8"
                                                    BorderBrush="#6B7A2A" BorderThickness="1" FontSize="11"/>
                                            <Button Content="清除头像" Margin="2" Padding="6,4"
                                                    Background="#0D1A14" Foreground="#B7C7A8"
                                                    BorderBrush="#6B7A2A" BorderThickness="1" FontSize="11"/>
                                        </UniformGrid>
                                        <Button Content="编辑角色资料" Margin="2,4,2,2" Padding="8,5"
                                                Background="#0D1A14" Foreground="#B7C7A8"
                                                BorderBrush="#6B7A2A" BorderThickness="1" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ═══ 中栏 ═══ -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="256"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- ── 经验区域 ── -->
                            <Grid Grid.Row="0">
                                <Border CornerRadius="6" Background="#0B1812" BorderBrush="#6B7A2A" BorderThickness="2"
                                        Effect="{StaticResource FelOuterGlow}">
                                    <Border CornerRadius="5" BorderBrush="#1D2410" BorderThickness="1"/>
                                </Border>
                                <Border CornerRadius="5" Margin="2" Background="Transparent">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PanelInnerTexture}" Opacity="1.0"/>
                                        <StackPanel Margin="16,10">
                                            <TextBlock Text="✦ 经验区域 ✦" Foreground="#7CFC00" FontSize="17" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,12"
                                                       Effect="{StaticResource FelOuterGlow}"/>
                                            <UniformGrid Columns="3" Margin="0,4">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="灵魂能量" Foreground="#7F8B75" FontSize="11"/>
                                                    <TextBlock x:Name="DashboardTotalExpText" Text="125,760" Foreground="#7CFC00"
                                                               FontSize="22" FontWeight="Bold"
                                                               Effect="{StaticResource FelOuterGlow}"/>
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="距离下一级" Foreground="#7F8B75" FontSize="11"/>
                                                    <TextBlock x:Name="DashboardNextLevelExpText" Text="24,240 EXP"
                                                               Foreground="#D7EFC2" FontSize="15" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="契约之日" Foreground="#7F8B75" FontSize="11"/>
                                                    <TextBlock x:Name="DashboardCreatedAtText" Text="2024-01-15"
                                                               Foreground="#7F8B75" FontSize="13" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </UniformGrid>
                                            <ProgressBar x:Name="DashboardExpProgressBar" Value="83.7" Height="16"
                                                         Background="#1D2410" Foreground="#7CFC00" Margin="0,14"
                                                         Effect="{StaticResource FelOuterGlow}"/>
                                            <TextBlock x:Name="DashboardExpProgressText"
                                                       Text="125,760 / 150,000 EXP" Foreground="#7F8B75"
                                                       FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ── 暗影契约区 ── -->
                            <Grid Grid.Row="2">
                                <Border CornerRadius="6" Background="#0B1812" BorderBrush="#6B7A2A" BorderThickness="2"
                                        Effect="{StaticResource FelOuterGlow}">
                                    <Border CornerRadius="5" BorderBrush="#1D2410" BorderThickness="1"/>
                                </Border>
                                <Border CornerRadius="5" Margin="2" Background="Transparent">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PanelInnerTexture}" Opacity="1.0"/>
                                        <TextBlock Text="❖ 暗影契约 ❖" Foreground="#7CFC00" FontSize="17" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"
                                                   Effect="{StaticResource FelOuterGlow}"/>
                                        <!-- 魔法阵中心区域 - 暗色底衬消隐黑边 -->
                                        <Border Width="340" Height="340" Background="#050A08"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                CornerRadius="170" Opacity="0.55"/>
                                        <Canvas HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Width="400" Height="400" Margin="0,15,0,0">
                                            <!-- 外层粒子光环 -->
                                            <Border Width="280" Height="280" Canvas.Left="60" Canvas.Top="60" Opacity="0.3">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="/Assets/Themes/UndeadWarlock/magic_circle_outer_glow.png"
                                                                Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/>
                                                </Border.Background>
                                            </Border>
                                            <!-- 外环符文 -->
                                            <Border Width="230" Height="230" Canvas.Left="85" Canvas.Top="85" Opacity="0.7">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="/Assets/Themes/UndeadWarlock/magic_circle_ring.png"
                                                                Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/>
                                                </Border.Background>
                                            </Border>
                                            <!-- 中心徽章 -->
                                            <Border Width="110" Height="110" Canvas.Left="145" Canvas.Top="145">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="/Assets/Themes/UndeadWarlock/magic_circle_emblem.png"
                                                                Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant"/>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#7CFC00" Opacity="0.85"/>
                                                </Border.Effect>
                                            </Border>

                                            <!-- 6个契约节点，用 Canvas 绝对定位 -->
                                            <!-- 节点0：顶部 -->
                                            <Border Width="84" Height="46" Canvas.Left="158" Canvas.Top="8"
                                                    Background="{StaticResource NodeBorderBrush}" BorderThickness="0">
                                                <TextBlock x:Name="ContractText_0" Text="暗影血肉&#x0a;Lv.19"
                                                           Foreground="#7CFC00" FontSize="9" TextAlignment="Center"
                                                           VerticalAlignment="Center" Effect="{StaticResource FelOuterGlow}"/>
                                            </Border>
                                            <!-- 节点1：右上 -->
                                            <Border Width="84" Height="46" Canvas.Left="290" Canvas.Top="90"
                                                    Background="{StaticResource NodeBorderBrush}" BorderThickness="0">
                                                <TextBlock x:Name="ContractText_1" Text="虚空意志&#x0a;Lv.23"
                                                           Foreground="#7CFC00" FontSize="9" TextAlignment="Center"
                                                           VerticalAlignment="Center" Effect="{StaticResource FelOuterGlow}"/>
                                            </Border>
                                            <!-- 节点2：右下 -->
                                            <Border Width="84" Height="46" Canvas.Left="290" Canvas.Top="255"
                                                    Background="{StaticResource NodeBorderBrush}" BorderThickness="0">
                                                <TextBlock x:Name="ContractText_2" Text="低语之舌&#x0a;Lv.15"
                                                           Foreground="#7CFC00" FontSize="9" TextAlignment="Center"
                                                           VerticalAlignment="Center" Effect="{StaticResource FelOuterGlow}"/>
                                            </Border>
                                            <!-- 节点3：底部 -->
                                            <Border Width="84" Height="46" Canvas.Left="158" Canvas.Top="346"
                                                    Background="{StaticResource NodeBorderBrush}" BorderThickness="0">
                                                <TextBlock x:Name="ContractText_3" Text="灵魂碎片&#x0a;Lv.17"
                                                           Foreground="#7CFC00" FontSize="9" TextAlignment="Center"
                                                           VerticalAlignment="Center" Effect="{StaticResource FelOuterGlow}"/>
                                            </Border>
                                            <!-- 节点4：左下 -->
                                            <Border Width="84" Height="46" Canvas.Left="26" Canvas.Top="255"
                                                    Background="{StaticResource NodeBorderBrush}" BorderThickness="0">
                                                <TextBlock x:Name="ContractText_4" Text="邪能造物&#x0a;Lv.21"
                                                           Foreground="#7CFC00" FontSize="9" TextAlignment="Center"
                                                           VerticalAlignment="Center" Effect="{StaticResource FelOuterGlow}"/>
                                            </Border>
                                            <!-- 节点5：左上 -->
                                            <Border Width="84" Height="46" Canvas.Left="26" Canvas.Top="90"
                                                    Background="{StaticResource NodeBorderBrush}" BorderThickness="0">
                                                <TextBlock x:Name="ContractText_5" Text="诅咒束缚&#x0a;Lv.16"
                                                           Foreground="#7CFC00" FontSize="9" TextAlignment="Center"
                                                           VerticalAlignment="Center" Effect="{StaticResource FelOuterGlow}"/>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ═══ 右栏 ═══ -->
                        <Grid Grid.Column="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="340"/>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- ── 装备区 ── -->
                            <Grid Grid.Row="0">
                                <Border CornerRadius="6" Background="#0B1812" BorderBrush="#6B7A2A" BorderThickness="2"
                                        Effect="{StaticResource FelOuterGlow}">
                                    <Border CornerRadius="5" BorderBrush="#1D2410" BorderThickness="1"/>
                                </Border>
                                <Border CornerRadius="5" Margin="2" Background="Transparent">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PanelInnerTexture}" Opacity="1.0"/>
                                        <Grid Margin="12,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="⚔ 当前装备" Foreground="#7CFC00" FontSize="16" FontWeight="Bold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"
                                                       Effect="{StaticResource FelOuterGlow}"/>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0"
                                                       Source="/Assets/Themes/UndeadWarlock/equip_slots.png"
                                                       Stretch="Uniform" Width="100"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Opacity="0.85" RenderOptions.BitmapScalingMode="Fant"/>
                                                <TextBlock x:Name="DashboardEquipText" Grid.Column="1"
                                                           Text="暂 无 装 备&#x0a;去寻找强大的装备吧"
                                                           Foreground="#7F8B75" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ── 活动日志 ── -->
                            <Grid Grid.Row="2">
                                <Border CornerRadius="6" Background="#0B1812" BorderBrush="#6B7A2A" BorderThickness="2"
                                        Effect="{StaticResource FelOuterGlow}">
                                    <Border CornerRadius="5" BorderBrush="#1D2410" BorderThickness="1"/>
                                </Border>
                                <Border CornerRadius="5" Margin="2" Background="Transparent">
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PanelInnerTexture}" Opacity="1.0"/>
                                        <Grid Margin="12,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="📋 最近变化" Foreground="#7F8B75" FontSize="13"
                                                       FontWeight="Bold" Margin="0,0,0,8"/>
                                            <ItemsControl x:Name="DashboardLogItemsControl" Grid.Row="1"
                                                          Margin="0,0,0,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                                <Image Source="/Assets/Themes/UndeadWarlock/star_icon_green.png"
                                                                       Width="14" Height="14" Stretch="Uniform"
                                                                       Margin="0,1,5,0" RenderOptions.BitmapScalingMode="Fant"/>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" Foreground="#7CFC00"
                                                                               FontSize="12" Effect="{StaticResource FelOuterGlow}"/>
                                                                    <TextBlock Text="{Binding Detail}" Foreground="#7F8B75"
                                                                               FontSize="10"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding TimeAgo}" Foreground="#608070"
                                                                       FontSize="10" HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button x:Name="DashboardViewAllLogsButton" Grid.Row="2"
                                                    Content="查看全部日志" Height="26"
                                                    Background="#0D1A14" Foreground="#7F8B75"
                                                    BorderBrush="#6B7A2A" BorderThickness="1" FontSize="11"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- ═══════════════ 其他页面（保留原内容供代码后置使用） ═══════════════ -->
                <!-- 隐藏控件：CharacterDashboardControl（代码后置需要） -->
                <controls:CharacterDashboardControl x:Name="CharacterDashboardControl"
                    Visibility="Collapsed" />

                <!-- 隐藏控件：统计相关命名元素 -->
                <StackPanel Visibility="Collapsed">
                    <TextBlock x:Name="TotalRecordsTextBlock" Text="0" />
                    <TextBlock x:Name="TotalExperienceTextBlock" Text="0" />
                    <TextBlock x:Name="TotalImagesTextBlock" Text="0" />
                    <TextBlock x:Name="RecordsWithImagesTextBlock" Text="0" />
                    <TextBlock x:Name="RecordsWithoutImagesTextBlock" Text="0" />
                    <TextBlock x:Name="CategoryCountTextBlock" Text="0" />
                    <TextBlock x:Name="LatestRecordCreatedAtTextBlock" Text="暂无记录" />
                    <DataGrid x:Name="CategoryStatisticsDataGrid" />
                    <DataGrid x:Name="DailyStatisticsDataGrid" />
                </StackPanel>

                <!-- 行为记录页 -->
                <ScrollViewer x:Name="RecordsPage" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="新增行为记录" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="标题" />
                                        <TextBox x:Name="TitleTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="分类" />
                                        <TextBox x:Name="CategoryTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="经验值" />
                                        <TextBox x:Name="ExperienceTextBox" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource LabelTextStyle}" Text="内容" />
                                <TextBox x:Name="ContentTextBox" MinHeight="100" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource LabelTextStyle}" Text="图片证据" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button x:Name="SelectImagesButton" Style="{StaticResource SoulAccentButtonStyle}"
                                            Width="110" Click="SelectImagesButton_Click" Content="选择图片" />
                                    <TextBlock x:Name="SelectedImagesCountTextBlock" Margin="10,10,0,0"
                                               Style="{StaticResource MutedTextBlockStyle}" Text="已选择 0 张图片" />
                                </WrapPanel>
                                <ListBox x:Name="SelectedImagesListBox" Margin="0,6,0,0" MaxHeight="70" />
                                <Button x:Name="SaveRecordButton" Margin="0,12,0,0" Width="110"
                                        HorizontalAlignment="Left" Click="SaveRecordButton_Click" Content="保存记录" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="筛选与搜索" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="关键词" />
                                        <TextBox x:Name="SearchKeywordTextBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="分类" />
                                        <ComboBox x:Name="CategoryFilterComboBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="开始日期" />
                                        <DatePicker x:Name="StartDatePicker" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="结束日期" />
                                        <DatePicker x:Name="EndDatePicker" />
                                    </StackPanel>
                                    <Button Grid.Column="8" VerticalAlignment="Bottom"
                                            Click="SearchRecordsButton_Click" Content="搜索" />
                                    <Button Grid.Column="10" VerticalAlignment="Bottom"
                                            Style="{StaticResource SoulAccentButtonStyle}"
                                            Click="ResetSearchButton_Click" Content="重置" />
                                </Grid>
                                <Border Margin="0,10,0,0" Style="{StaticResource StatCardBorderStyle}"
                                        Background="{StaticResource WarlockCardAltBrush}"
                                        BorderBrush="{StaticResource WarlockGoldBrush}">
                                    <TextBlock x:Name="ResultCountTextBlock" Style="{StaticResource FieldValueTextStyle}"
                                               Text="当前显示 0 条记录" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.5*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="最近行为记录" />
                                    <ListBox x:Name="RecordsListBox" Margin="0,10,0,0" MinHeight="200"
                                             SelectionChanged="RecordsListBox_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource WarlockSoulGreenBrush}"
                                                                   Text="{Binding Title}" />
                                                        <Border DockPanel.Dock="Right" Padding="8,3"
                                                                Background="{StaticResource WarlockSelectionBrush}"
                                                                BorderBrush="{StaticResource WarlockSoulGreenBrush}"
                                                                BorderThickness="1" CornerRadius="10">
                                                            <TextBlock FontSize="12" Foreground="{StaticResource WarlockSoulGreenBrush}"
                                                                       Text="{Binding ImageCount, StringFormat=图片 {0}}" />
                                                        </Border>
                                                    </DockPanel>
                                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource MutedTextBlockStyle}"
                                                               Text="{Binding Category, StringFormat=分类：{0}}" />
                                                    <TextBlock Style="{StaticResource MutedTextBlockStyle}"
                                                               Text="{Binding Experience, StringFormat=经验值：{0}}" />
                                                    <TextBlock Style="{StaticResource MutedTextBlockStyle}"
                                                               Text="{Binding CreatedAt, StringFormat=创建时间：{0:yyyy-MM-dd HH:mm}}" />
                                                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                               Foreground="{StaticResource WarlockTextPrimaryBrush}"
                                                               Text="{Binding ContentPreview}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="记录详情" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="标题" />
                                                <TextBox x:Name="DetailTitleTextBox" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="分类" />
                                                <TextBox x:Name="DetailCategoryTextBox" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="经验值" />
                                                <TextBox x:Name="DetailExperienceTextBox" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Margin="0,10,0,0" Style="{StaticResource LabelTextStyle}" Text="内容" />
                                        <TextBox x:Name="DetailContentTextBox" MinHeight="100" AcceptsReturn="True"
                                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource StatCardBorderStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="创建时间" />
                                                    <TextBlock x:Name="DetailCreatedAtTextBlock" Style="{StaticResource FieldValueTextStyle}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource StatCardBorderStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="更新时间" />
                                                    <TextBlock x:Name="DetailUpdatedAtTextBlock" Style="{StaticResource FieldValueTextStyle}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="SaveDetailButton" Width="110" Click="SaveDetailButton_Click" Content="保存修改" />
                                            <Button x:Name="DeleteRecordButton" Margin="10,0,0,0" Width="130"
                                                    Style="{StaticResource DangerButtonStyle}" Click="DeleteRecordButton_Click" Content="删除" />
                                        </WrapPanel>
                                        <Border Margin="0,12,0,0" Style="{StaticResource StatCardBorderStyle}"
                                                Background="{StaticResource WarlockCardAltBrush}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="来源行动任务" />
                                                <TextBlock x:Name="SourceActionTaskTextBlock" Style="{StaticResource FieldValueTextStyle}" Text="无" />
                                                <Button x:Name="ViewSourceActionTaskButton" Margin="0,8,0,0" Width="90"
                                                        HorizontalAlignment="Left" Click="ViewSourceActionTaskButton_Click" Content="查看任务" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Margin="0,14,0,0" Style="{StaticResource SectionSubtitleTextBlockStyle}" Text="图片预览" />
                                        <ScrollViewer Margin="0,8,0,0" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="ImagePreviewItemsControl">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,8,8" Width="155" Style="{StaticResource StatCardBorderStyle}"
                                                                Background="{StaticResource WarlockCardAltBrush}">
                                                            <StackPanel>
                                                                <Border Width="132" Height="98" HorizontalAlignment="Center"
                                                                        Style="{StaticResource ImagePreviewBorderStyle}">
                                                                    <Image Source="{Binding PreviewImageSource}" Stretch="UniformToFill" />
                                                                </Border>
                                                                <TextBlock Margin="0,6,0,0" FontSize="11"
                                                                           Foreground="{StaticResource WarlockTextPrimaryBrush}" Text="{Binding FileName}" />
                                                                <Button Margin="0,6,0,0" HorizontalAlignment="Left"
                                                                        Style="{StaticResource DangerButtonStyle}"
                                                                        Click="DeleteImageButton_Click" Tag="{Binding Id}" Content="删除" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 行动任务 -->
                <ScrollViewer x:Name="TasksPage" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <controls:ActionTaskControl x:Name="ActionTaskControl" />
                </ScrollViewer>

                <!-- 成长属性 -->
                <ScrollViewer x:Name="AttributesPage" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="成长属性总览" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedTextBlockStyle}"
                                           Text="六项核心属性，展示当前等级与经验进度。" />
                                <UniformGrid Margin="0,14,0,0" Columns="3">
                                    <Border x:Name="AttrCard_physique" Margin="0,0,14,14" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Foreground="{StaticResource WarlockSoulGreenBrush}" Text="体魄" />
                                            <TextBlock x:Name="AttrLevel_physique" FontSize="28" FontWeight="Bold"
                                                       Foreground="{StaticResource WarlockTextPrimaryBrush}" Margin="0,6,0,0" Text="Lv.1" />
                                            <ProgressBar x:Name="AttrBar_physique" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="50" />
                                            <TextBlock x:Name="AttrExp_physique" Margin="0,6,0,0" Style="{StaticResource MutedTextBlockStyle}" Text="0/100 EXP" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="AttrCard_mind" Margin="0,0,14,14" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Foreground="{StaticResource WarlockSoulGreenBrush}" Text="心智" />
                                            <TextBlock x:Name="AttrLevel_mind" FontSize="28" FontWeight="Bold"
                                                       Foreground="{StaticResource WarlockTextPrimaryBrush}" Margin="0,6,0,0" Text="Lv.1" />
                                            <ProgressBar x:Name="AttrBar_mind" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="50" />
                                            <TextBlock x:Name="AttrExp_mind" Margin="0,6,0,0" Style="{StaticResource MutedTextBlockStyle}" Text="0/100 EXP" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="AttrCard_discipline" Margin="0,0,0,14" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Foreground="{StaticResource WarlockSoulGreenBrush}" Text="纪律" />
                                            <TextBlock x:Name="AttrLevel_discipline" FontSize="28" FontWeight="Bold"
                                                       Foreground="{StaticResource WarlockTextPrimaryBrush}" Margin="0,6,0,0" Text="Lv.1" />
                                            <ProgressBar x:Name="AttrBar_discipline" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="50" />
                                            <TextBlock x:Name="AttrExp_discipline" Margin="0,6,0,0" Style="{StaticResource MutedTextBlockStyle}" Text="0/100 EXP" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="AttrCard_expression" Margin="0,0,14,0" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Foreground="{StaticResource WarlockSoulGreenBrush}" Text="表达" />
                                            <TextBlock x:Name="AttrLevel_expression" FontSize="28" FontWeight="Bold"
                                                       Foreground="{StaticResource WarlockTextPrimaryBrush}" Margin="0,6,0,0" Text="Lv.1" />
                                            <ProgressBar x:Name="AttrBar_expression" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="50" />
                                            <TextBlock x:Name="AttrExp_expression" Margin="0,6,0,0" Style="{StaticResource MutedTextBlockStyle}" Text="0/100 EXP" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="AttrCard_creativity" Margin="0,0,14,0" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Foreground="{StaticResource WarlockSoulGreenBrush}" Text="创造" />
                                            <TextBlock x:Name="AttrLevel_creativity" FontSize="28" FontWeight="Bold"
                                                       Foreground="{StaticResource WarlockTextPrimaryBrush}" Margin="0,6,0,0" Text="Lv.1" />
                                            <ProgressBar x:Name="AttrBar_creativity" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="50" />
                                            <TextBlock x:Name="AttrExp_creativity" Margin="0,6,0,0" Style="{StaticResource MutedTextBlockStyle}" Text="0/100 EXP" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="AttrCard_resources" Margin="0,0,0,0" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Foreground="{StaticResource WarlockSoulGreenBrush}" Text="资源" />
                                            <TextBlock x:Name="AttrLevel_resources" FontSize="28" FontWeight="Bold"
                                                       Foreground="{StaticResource WarlockTextPrimaryBrush}" Margin="0,6,0,0" Text="Lv.1" />
                                            <ProgressBar x:Name="AttrBar_resources" Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100" Value="50" />
                                            <TextBlock x:Name="AttrExp_resources" Margin="0,6,0,0" Style="{StaticResource MutedTextBlockStyle}" Text="0/100 EXP" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="最近属性变化" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedTextBlockStyle}"
                                           Text="最近 20 条属性变化记录。" />
                                <ItemsControl x:Name="AttributesLogItemsControl" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Style="{StaticResource StatCardBorderStyle}"
                                                    Background="{StaticResource WarlockCardAltBrush}">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock FontWeight="Bold" Foreground="{StaticResource WarlockSoulGreenBrush}"
                                                                   Text="{Binding Title}" />
                                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedTextBlockStyle}"
                                                                   Text="{Binding CreatedAtText}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextBlockStyle}"
                                                               Text="{Binding Detail}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 图片证据 -->
                <ScrollViewer x:Name="ImagesPage" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="图片证据" />
                            <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedTextBlockStyle}"
                                       Text="浏览所有已上传的图片证据，按记录分类展示。" />
                            <ItemsControl x:Name="ImagesGalleryItemsControl" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,10" Width="200" Style="{StaticResource StatCardBorderStyle}"
                                                Background="{StaticResource WarlockCardAltBrush}">
                                            <StackPanel>
                                                <Border Width="176" Height="130" HorizontalAlignment="Center"
                                                        Style="{StaticResource ImagePreviewBorderStyle}">
                                                    <Image Source="{Binding PreviewImageSource}" Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{StaticResource WarlockTextPrimaryBrush}" Text="{Binding FileName}" />
                                                <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextBlockStyle}"
                                                           Text="{Binding RecordTitle, StringFormat=记录：{0}}" />
                                                <TextBlock Style="{StaticResource MutedTextBlockStyle}"
                                                           Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- 复盘归档 -->
                <ScrollViewer x:Name="ArchivePage" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="数据备份" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="CreateBackupButton" Width="110" Click="CreateBackupButton_Click" Content="创建备份" />
                                    <Button x:Name="CreateBackupToDirectoryButton" Margin="10,0,0,0" Width="140"
                                            Click="CreateBackupToDirectoryButton_Click" Content="选择目录备份" />
                                    <Button x:Name="OpenBackupsDirectoryButton" Margin="10,0,0,0" Width="110"
                                            Style="{StaticResource SoulAccentButtonStyle}"
                                            Click="OpenBackupsDirectoryButton_Click" Content="打开备份目录" />
                                    <Button x:Name="RestoreBackupButton" Margin="10,0,0,0" Width="110"
                                            Style="{StaticResource DangerButtonStyle}" Click="RestoreBackupButton_Click" Content="从备份恢复" />
                                </WrapPanel>
                                <Border Margin="0,10,0,0" Style="{StaticResource StatCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="最近备份路径" />
                                        <TextBlock x:Name="LatestBackupPathTextBlock" Style="{StaticResource FieldValueTextStyle}" Text="暂无" />
                                        <TextBlock Margin="0,6,0,4" Style="{StaticResource LabelTextStyle}" Text="备份状态" />
                                        <TextBlock x:Name="BackupStatusTextBlock" Style="{StaticResource FieldValueTextStyle}"
                                                   Text="尚未执行备份或恢复操作。" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Margin="0,16,0,0" Style="{StaticResource SectionSubtitleTextBlockStyle}" Text="备份历史" />
                                <DataGrid x:Name="BackupHistoryDataGrid" Margin="0,8,0,0"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" MinHeight="140"
                                          SelectionChanged="BackupHistoryDataGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="3*" />
                                        <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="100" />
                                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="RestoreSelectedBackupButton" Width="120"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Click="RestoreSelectedBackupButton_Click" Content="恢复选中备份" />
                                    <Button x:Name="RefreshBackupListButton" Margin="10,0,0,0" Width="110"
                                            Click="RefreshBackupListButton_Click" Content="刷新列表" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="数据导出" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="ExportMarkdownButton" Width="130" Click="ExportMarkdownButton_Click" Content="导出 Markdown" />
                                    <Button x:Name="ExportMarkdownToDirectoryButton" Margin="10,0,0,0" Width="150"
                                            Click="ExportMarkdownToDirectoryButton_Click" Content="选择目录导出" />
                                    <Button x:Name="OpenExportsDirectoryButton" Margin="10,0,0,0" Width="110"
                                            Style="{StaticResource SoulAccentButtonStyle}"
                                            Click="OpenExportsDirectoryButton_Click" Content="打开导出目录" />
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="ExportFilteredMarkdownButton" Width="140" Style="{StaticResource SoulAccentButtonStyle}"
                                            Click="ExportFilteredMarkdownButton_Click" Content="导出筛选结果" />
                                    <Button x:Name="ExportFilteredMarkdownToDirectoryButton" Margin="10,0,0,0" Width="160"
                                            Click="ExportFilteredMarkdownToDirectoryButton_Click" Content="选择目录导出筛选" />
                                </WrapPanel>
                                <Border Margin="0,10,0,0" Style="{StaticResource StatCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="最近导出路径" />
                                        <TextBlock x:Name="LatestExportPathTextBlock" Style="{StaticResource FieldValueTextStyle}" Text="暂无" />
                                        <TextBlock Margin="0,6,0,4" Style="{StaticResource LabelTextStyle}" Text="导出状态" />
                                        <TextBlock x:Name="ExportStatusTextBlock" Style="{StaticResource FieldValueTextStyle}"
                                                   Text="尚未执行 Markdown 导出操作。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- 设置 -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="应用信息" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="应用版本" />
                                            <TextBlock x:Name="SettingsVersionText" Style="{StaticResource FieldValueTextStyle}" Text="v1.2" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="运行环境" />
                                            <TextBlock x:Name="SettingsRuntimeText" Style="{StaticResource FieldValueTextStyle}" Text=".NET 8 WPF" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="记录总数" />
                                            <TextBlock x:Name="SettingsRecordCountText" Style="{StaticResource StatValueTextBlockStyle}" Text="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="图片总数" />
                                            <TextBlock x:Name="SettingsImageCountText" Style="{StaticResource StatValueTextBlockStyle}" Text="0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4" Style="{StaticResource StatCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="数据库大小" />
                                            <TextBlock x:Name="SettingsDbSizeText" Style="{StaticResource StatValueTextBlockStyle}" Text="-" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,10,0,0" Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextBlockStyle}" Text="数据目录" />
                                <TextBlock Margin="0,8,0,0" Style="{StaticResource MutedTextBlockStyle}"
                                           Text="所有应用数据存储在本地，不依赖云端。" />
                                <Border Margin="0,12,0,0" Style="{StaticResource StatCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="数据根目录" />
                                        <TextBlock x:Name="SettingsRootPathText" Style="{StaticResource FieldValueTextStyle}" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button x:Name="OpenDataDirButton" Width="110" Click="OpenDataDirButton_Click" Content="打开目录" />
                                            <Button x:Name="ChangeDataDirButton" Margin="10,0,0,0" Width="110"
                                                    Style="{StaticResource SoulAccentButtonStyle}"
                                                    Click="ChangeDataDirButton_Click" Content="修改目录" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,8,0,0" Style="{StaticResource StatCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="数据库路径" />
                                        <TextBlock x:Name="SettingsDbPathText" Style="{StaticResource FieldValueTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,8,0,0" Style="{StaticResource StatCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="图片资源目录" />
                                        <TextBlock x:Name="SettingsAssetsPathText" Style="{StaticResource FieldValueTextStyle}" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button x:Name="OpenAssetsDirButton" Width="110" Click="OpenAssetsDirButton_Click" Content="打开目录" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,8,0,0" Style="{StaticResource StatCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="备份目录" />
                                        <TextBlock x:Name="SettingsBackupsPathText" Style="{StaticResource FieldValueTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,8,0,0" Style="{StaticResource StatCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="键盘快捷键" />
                                        <TextBlock x:Name="SettingsKeyboardShortcutText" Style="{StaticResource FieldValueTextStyle}"
                                                   Text="修改按钮快捷键" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Width="120" Click="OpenShortcutSettings_Click" Content="设置快捷键" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
