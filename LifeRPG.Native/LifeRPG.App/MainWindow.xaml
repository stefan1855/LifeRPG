<Window x:Class="LifeRPG.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Life RPG Native"
        Height="900"
        Width="1360"
        MinHeight="760"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="24,24,24,16"
                Padding="24"
                Background="#1F2937"
                CornerRadius="18">
            <StackPanel>
                <TextBlock Text="Life RPG Native"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Margin="0,8,0,0"
                           Text="独立 Windows 原生版人生规划软件"
                           FontSize="14"
                           Foreground="#D1D5DB" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    Background="White"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock Margin="4,0,0,16"
                               Text="导航"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#374151" />
                    <Button Margin="0,0,0,10" Padding="14,10" Content="首页" />
                    <Button Margin="0,0,0,10" Padding="14,10" Content="行为记录" />
                    <Button Margin="0,0,0,10" Padding="14,10" Content="成长属性" />
                    <Button Margin="0,0,0,10" Padding="14,10" Content="图片证据" />
                    <Button Margin="0,0,0,10" Padding="14,10" Content="复盘归档" />
                    <Button Padding="14,10" Content="设置" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="24"
                            Background="White"
                            CornerRadius="18">
                        <StackPanel>
                            <TextBlock Text="首页"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock Margin="0,10,0,0"
                                       Text="当前阶段聚焦行为记录新增、详情查看、编辑与图片证据删除。"
                                       FontSize="14"
                                       Foreground="#4B5563" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="24"
                            Background="White"
                            CornerRadius="18">
                        <StackPanel>
                            <TextBlock Text="新增行为记录"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="标题" Foreground="#374151" />
                                    <TextBox x:Name="TitleTextBox"
                                             Margin="0,6,0,0"
                                             Padding="10" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="分类" Foreground="#374151" />
                                    <TextBox x:Name="CategoryTextBox"
                                             Margin="0,6,0,0"
                                             Padding="10" />
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="经验值" Foreground="#374151" />
                                    <TextBox x:Name="ExperienceTextBox"
                                             Margin="0,6,0,0"
                                             Padding="10" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,16,0,0"
                                       Text="内容"
                                       Foreground="#374151" />
                            <TextBox x:Name="ContentTextBox"
                                     Margin="0,6,0,0"
                                     Padding="10"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="120" />

                            <TextBlock Margin="0,16,0,0"
                                       Text="图片证据"
                                       Foreground="#374151" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="SelectImagesButton"
                                        Width="120"
                                        Padding="14,10"
                                        Background="#E5E7EB"
                                        Click="SelectImagesButton_Click"
                                        Content="选择图片" />
                                <TextBlock x:Name="SelectedImagesCountTextBlock"
                                           Margin="12,10,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="#4B5563"
                                           Text="已选择 0 张图片" />
                            </WrapPanel>

                            <ListBox x:Name="SelectedImagesListBox"
                                     Margin="0,10,0,0"
                                     MaxHeight="100" />

                            <Button x:Name="SaveRecordButton"
                                    Margin="0,18,0,0"
                                    Width="120"
                                    Padding="14,10"
                                    HorizontalAlignment="Left"
                                    Background="#1F2937"
                                    Foreground="White"
                                    Click="SaveRecordButton_Click"
                                    Content="保存记录" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="24"
                            Background="White"
                            CornerRadius="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="最近行为记录"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />
                                <Border Margin="0,18,0,0"
                                        Padding="16"
                                        Background="#F9FAFB"
                                        CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Text="筛选与搜索"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="关键词"
                                                           Foreground="#374151" />
                                                <TextBox x:Name="SearchKeywordTextBox"
                                                         Margin="0,6,0,0"
                                                         Padding="10" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="分类"
                                                           Foreground="#374151" />
                                                <ComboBox x:Name="CategoryFilterComboBox"
                                                          Margin="0,6,0,0"
                                                          Padding="8" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="开始日期"
                                                           Foreground="#374151" />
                                                <DatePicker x:Name="StartDatePicker"
                                                            Margin="0,6,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="结束日期"
                                                           Foreground="#374151" />
                                                <DatePicker x:Name="EndDatePicker"
                                                            Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <WrapPanel Margin="0,14,0,0">
                                            <Button x:Name="SearchRecordsButton"
                                                    Width="100"
                                                    Padding="14,10"
                                                    Background="#1F2937"
                                                    Foreground="White"
                                                    Click="SearchRecordsButton_Click"
                                                    Content="搜索" />
                                            <Button x:Name="ResetSearchButton"
                                                    Margin="12,0,0,0"
                                                    Width="100"
                                                    Padding="14,10"
                                                    Click="ResetSearchButton_Click"
                                                    Content="重置" />
                                            <TextBlock x:Name="ResultCountTextBlock"
                                                       Margin="16,10,0,0"
                                                       Foreground="#4B5563"
                                                       Text="当前显示 0 条记录" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <ListBox x:Name="RecordsListBox"
                                         Margin="0,18,0,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         SelectionChanged="RecordsListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,12"
                                                    Padding="16"
                                                    Background="#F9FAFB"
                                                    CornerRadius="12">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="False">
                                                        <TextBlock DockPanel.Dock="Left"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#111827"
                                                                   Text="{Binding Title}" />
                                                        <TextBlock DockPanel.Dock="Right"
                                                                   Foreground="#6B7280"
                                                                   Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" />
                                                    </DockPanel>
                                                    <TextBlock Margin="0,8,0,0"
                                                               Foreground="#374151"
                                                               Text="{Binding Category, StringFormat=分类：{0}}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="#374151"
                                                               Text="{Binding Experience, StringFormat=经验值：{0}}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="#374151"
                                                               Text="{Binding ImageCount, StringFormat=图片数量：{0}}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               TextWrapping="Wrap"
                                                               Foreground="#4B5563"
                                                               Text="{Binding ContentPreview}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="记录详情"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#111827" />

                                <TextBlock x:Name="DetailPlaceholderTextBlock"
                                           Margin="0,18,0,0"
                                           Foreground="#6B7280"
                                           Text="请选择一条记录" />

                                <StackPanel x:Name="DetailPanel"
                                            Margin="0,18,0,0"
                                            Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="标题" Foreground="#374151" />
                                            <TextBox x:Name="DetailTitleTextBox"
                                                     Margin="0,6,0,0"
                                                     Padding="10" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="分类" Foreground="#374151" />
                                            <TextBox x:Name="DetailCategoryTextBox"
                                                     Margin="0,6,0,0"
                                                     Padding="10" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="经验值" Foreground="#374151" />
                                            <TextBox x:Name="DetailExperienceTextBox"
                                                     Margin="0,6,0,0"
                                                     Padding="10" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Margin="0,16,0,0"
                                               Text="内容"
                                               Foreground="#374151" />
                                    <TextBox x:Name="DetailContentTextBox"
                                             Margin="0,6,0,0"
                                             Padding="10"
                                             MinHeight="120"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" />

                                    <Grid Margin="0,16,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="创建时间"
                                                       FontWeight="SemiBold"
                                                       Foreground="#111827" />
                                            <TextBlock x:Name="DetailCreatedAtTextBlock"
                                                       Margin="0,6,0,0"
                                                       Foreground="#4B5563" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="更新时间"
                                                       FontWeight="SemiBold"
                                                       Foreground="#111827" />
                                            <TextBlock x:Name="DetailUpdatedAtTextBlock"
                                                       Margin="0,6,0,0"
                                                       Foreground="#4B5563" />
                                        </StackPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,18,0,0">
                                        <Button x:Name="SaveDetailButton"
                                                Width="120"
                                                Padding="14,10"
                                                Background="#1F2937"
                                                Foreground="White"
                                                Click="SaveDetailButton_Click"
                                                Content="保存修改" />
                                        <Button x:Name="DeleteRecordButton"
                                                Margin="12,0,0,0"
                                                Width="140"
                                                Padding="14,10"
                                                Background="#B91C1C"
                                                Foreground="White"
                                                Click="DeleteRecordButton_Click"
                                                Content="删除当前记录" />
                                    </WrapPanel>

                                    <TextBlock Margin="0,24,0,0"
                                               Text="图片证据"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#111827" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#4B5563"
                                               Text="可预览并删除当前记录的图片证据。" />

                                    <ScrollViewer Margin="0,18,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="340">
                                        <ItemsControl x:Name="ImagePreviewItemsControl">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,12,12"
                                                            Padding="10"
                                                            Width="172"
                                                            Background="#F9FAFB"
                                                            CornerRadius="10">
                                                        <StackPanel>
                                                            <Border Width="150"
                                                                    Height="120"
                                                                    Background="#E5E7EB"
                                                                    CornerRadius="8"
                                                                    ClipToBounds="True">
                                                                <Image Source="{Binding PreviewImageSource}"
                                                                       Stretch="UniformToFill" />
                                                            </Border>
                                                            <TextBlock Margin="0,8,0,0"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="12"
                                                                       Foreground="#374151"
                                                                       Text="{Binding FileName}" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       FontSize="11"
                                                                       Foreground="#6B7280"
                                                                       Text="{Binding CreatedAt, StringFormat=上传时间：yyyy-MM-dd HH:mm}" />
                                                            <Button Margin="0,10,0,0"
                                                                    Padding="10,6"
                                                                    HorizontalAlignment="Left"
                                                                    Click="DeleteImageButton_Click"
                                                                    Tag="{Binding Id}"
                                                                    Content="删除图片" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,16,0,0"
                            Padding="24"
                            Background="White"
                            CornerRadius="18">
                        <StackPanel>
                            <TextBlock Text="系统状态"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock Margin="0,18,0,8"
                                       Text="当前版本：v0.1.0-native-dev"
                                       FontSize="15"
                                       Foreground="#374151" />
                            <TextBlock Margin="0,0,0,8"
                                       Text="存储模式：本地 SQLite + 本地图片目录"
                                       FontSize="15"
                                       Foreground="#374151" />
                            <TextBlock Margin="0,0,0,8"
                                       Text="Obsidian 依赖：否"
                                       FontSize="15"
                                       Foreground="#374151" />
                            <TextBlock Margin="0,0,0,8"
                                       Text="浏览器内核：否"
                                       FontSize="15"
                                       Foreground="#374151" />
                            <TextBlock Margin="0,12,0,4"
                                       Text="当前数据根目录"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock x:Name="RootPathTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="#4B5563" />
                            <TextBlock Margin="0,16,0,4"
                                       Text="当前数据库路径"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock x:Name="DatabasePathTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="#4B5563" />
                            <TextBlock Margin="0,16,0,4"
                                       Text="当前图片目录路径"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock x:Name="AssetsPathTextBlock"
                                       TextWrapping="Wrap"
                                       Foreground="#4B5563" />

                            <Separator Margin="0,20,0,20" />

                            <TextBlock Text="数据备份"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button x:Name="CreateBackupButton"
                                        Width="120"
                                        Padding="14,10"
                                        Background="#1F2937"
                                        Foreground="White"
                                        Click="CreateBackupButton_Click"
                                        Content="创建备份" />
                                <Button x:Name="CreateBackupToDirectoryButton"
                                        Margin="12,0,0,0"
                                        Width="150"
                                        Padding="14,10"
                                        Click="CreateBackupToDirectoryButton_Click"
                                        Content="选择目录并备份" />
                                <Button x:Name="OpenBackupsDirectoryButton"
                                        Margin="12,0,0,0"
                                        Width="120"
                                        Padding="14,10"
                                        Click="OpenBackupsDirectoryButton_Click"
                                        Content="打开备份目录" />
                                <Button x:Name="RestoreBackupButton"
                                        Margin="12,0,0,0"
                                        Width="120"
                                        Padding="14,10"
                                        Background="#B45309"
                                        Foreground="White"
                                        Click="RestoreBackupButton_Click"
                                        Content="从备份恢复" />
                            </WrapPanel>
                            <TextBlock Margin="0,18,0,4"
                                       Text="最近备份路径"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock x:Name="LatestBackupPathTextBlock"
                                       Text="暂无"
                                       TextWrapping="Wrap"
                                       Foreground="#4B5563" />
                            <TextBlock Margin="0,16,0,4"
                                       Text="备份状态提示"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock x:Name="BackupStatusTextBlock"
                                       Text="尚未执行备份或恢复操作。"
                                       TextWrapping="Wrap"
                                       Foreground="#4B5563" />

                            <Separator Margin="0,20,0,20" />

                            <TextBlock Text="数据导出"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button x:Name="ExportMarkdownButton"
                                        Width="140"
                                        Padding="14,10"
                                        Background="#1F2937"
                                        Foreground="White"
                                        Click="ExportMarkdownButton_Click"
                                        Content="导出 Markdown" />
                                <Button x:Name="ExportMarkdownToDirectoryButton"
                                        Margin="12,0,0,0"
                                        Width="190"
                                        Padding="14,10"
                                        Click="ExportMarkdownToDirectoryButton_Click"
                                        Content="选择目录并导出 Markdown" />
                                <Button x:Name="OpenExportsDirectoryButton"
                                        Margin="12,0,0,0"
                                        Width="120"
                                        Padding="14,10"
                                        Click="OpenExportsDirectoryButton_Click"
                                        Content="打开导出目录" />
                            </WrapPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="ExportFilteredMarkdownButton"
                                        Width="190"
                                        Padding="14,10"
                                        Background="#0F766E"
                                        Foreground="White"
                                        Click="ExportFilteredMarkdownButton_Click"
                                        Content="导出当前筛选结果 Markdown" />
                                <Button x:Name="ExportFilteredMarkdownToDirectoryButton"
                                        Margin="12,0,0,0"
                                        Width="220"
                                        Padding="14,10"
                                        Click="ExportFilteredMarkdownToDirectoryButton_Click"
                                        Content="选择目录并导出当前筛选结果" />
                            </WrapPanel>
                            <TextBlock Margin="0,18,0,4"
                                       Text="最近导出路径"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock x:Name="LatestExportPathTextBlock"
                                       Text="暂无"
                                       TextWrapping="Wrap"
                                       Foreground="#4B5563" />
                            <TextBlock Margin="0,16,0,4"
                                       Text="导出状态提示"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#111827" />
                            <TextBlock x:Name="ExportStatusTextBlock"
                                       Text="尚未执行 Markdown 导出操作。"
                                       TextWrapping="Wrap"
                                       Foreground="#4B5563" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
