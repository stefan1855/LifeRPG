<Window x:Class="LifeRPG.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Life RPG Native"
        Height="640"
        Width="1100"
        MinHeight="560"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="24,24,24,16"
                Padding="24"
                Background="#1F2937"
                CornerRadius="18">
            <StackPanel>
                <TextBlock Text="Life RPG Native"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Margin="0,8,0,0"
                           Text="独立 Windows 原生版人生规划软件"
                           FontSize="14"
                           Foreground="#D1D5DB" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    Background="White"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock Margin="4,0,0,16"
                               Text="导航"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#374151" />
                    <Button Margin="0,0,0,10" Padding="14,10" Content="首页" />
                    <Button Margin="0,0,0,10" Padding="14,10" Content="行为记录" />
                    <Button Margin="0,0,0,10" Padding="14,10" Content="成长属性" />
                    <Button Margin="0,0,0,10" Padding="14,10" Content="图片证据" />
                    <Button Margin="0,0,0,10" Padding="14,10" Content="复盘归档" />
                    <Button Padding="14,10" Content="设置" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="24"
                    Background="White"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock Text="系统概览"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock Margin="0,18,0,8"
                               Text="当前版本：v0.1.0-native-dev"
                               FontSize="15"
                               Foreground="#374151" />
                    <TextBlock Margin="0,0,0,8"
                               Text="存储模式：本地 SQLite + 本地图片目录"
                               FontSize="15"
                               Foreground="#374151" />
                    <TextBlock Margin="0,0,0,8"
                               Text="Obsidian 依赖：否"
                               FontSize="15"
                               Foreground="#374151" />
                    <TextBlock Margin="0,0,0,8"
                               Text="浏览器内核：否"
                               FontSize="15"
                               Foreground="#374151" />
                    <TextBlock Margin="0,12,0,4"
                               Text="当前数据库路径"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock x:Name="DatabasePathTextBlock"
                               TextWrapping="Wrap"
                               Foreground="#4B5563" />
                    <TextBlock Margin="0,16,0,4"
                               Text="当前图片目录路径"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#111827" />
                    <TextBlock x:Name="AssetsPathTextBlock"
                               TextWrapping="Wrap"
                               Foreground="#4B5563" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
