<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light Theme — Ancient Tome / Scholar's Desk -->
    <Color x:Key="WarlockBlackColor">#F5F0E8</Color>
    <Color x:Key="WarlockAbyssColor">#EDE4D4</Color>
    <Color x:Key="WarlockCardColor">#FFFBF2</Color>
    <Color x:Key="WarlockCardAltColor">#F8F2E6</Color>
    <Color x:Key="WarlockSoulGreenColor">#2D7D46</Color>
    <Color x:Key="WarlockArcanePurpleColor">#6B3FA0</Color>
    <Color x:Key="WarlockGoldColor">#B8860B</Color>
    <Color x:Key="WarlockDangerColor">#C0392B</Color>
    <Color x:Key="WarlockTextPrimaryColor">#2C2416</Color>
    <Color x:Key="WarlockTextSecondaryColor">#5C4F3A</Color>
    <Color x:Key="WarlockTextMutedColor">#9B8D7B</Color>
    <Color x:Key="WarlockBorderColor">#C4B8A3</Color>
    <Color x:Key="WarlockHighlightBorderColor">#2D7D46</Color>
    <Color x:Key="WarlockHeaderColor">#EBE0CC</Color>
    <Color x:Key="WarlockRowColor">#FFFBF2</Color>
    <Color x:Key="WarlockRowAltColor">#F5EFE2</Color>
    <Color x:Key="WarlockSelectionColor">#E8D9B5</Color>

    <SolidColorBrush x:Key="WarlockBlackBrush" Color="{StaticResource WarlockBlackColor}" />
    <SolidColorBrush x:Key="WarlockAbyssBrush" Color="{StaticResource WarlockAbyssColor}" />
    <SolidColorBrush x:Key="WarlockCardBrush" Color="{StaticResource WarlockCardColor}" />
    <SolidColorBrush x:Key="WarlockCardAltBrush" Color="{StaticResource WarlockCardAltColor}" />
    <SolidColorBrush x:Key="WarlockSoulGreenBrush" Color="{StaticResource WarlockSoulGreenColor}" />
    <SolidColorBrush x:Key="WarlockArcanePurpleBrush" Color="{StaticResource WarlockArcanePurpleColor}" />
    <SolidColorBrush x:Key="WarlockGoldBrush" Color="{StaticResource WarlockGoldColor}" />
    <SolidColorBrush x:Key="WarlockDangerBrush" Color="{StaticResource WarlockDangerColor}" />
    <SolidColorBrush x:Key="WarlockTextPrimaryBrush" Color="{StaticResource WarlockTextPrimaryColor}" />
    <SolidColorBrush x:Key="WarlockTextSecondaryBrush" Color="{StaticResource WarlockTextSecondaryColor}" />
    <SolidColorBrush x:Key="WarlockTextMutedBrush" Color="{StaticResource WarlockTextMutedColor}" />
    <SolidColorBrush x:Key="WarlockBorderBrush" Color="{StaticResource WarlockBorderColor}" />
    <SolidColorBrush x:Key="WarlockHighlightBorderBrush" Color="{StaticResource WarlockHighlightBorderColor}" />
    <SolidColorBrush x:Key="WarlockHeaderBrush" Color="{StaticResource WarlockHeaderColor}" />
    <SolidColorBrush x:Key="WarlockRowBrush" Color="{StaticResource WarlockRowColor}" />
    <SolidColorBrush x:Key="WarlockRowAltBrush" Color="{StaticResource WarlockRowAltColor}" />
    <SolidColorBrush x:Key="WarlockSelectionBrush" Color="{StaticResource WarlockSelectionColor}" />

    <LinearGradientBrush x:Key="WarlockWindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F5F0E8" />
        <GradientStop Offset="0.45" Color="#EDE4D4" />
        <GradientStop Offset="1" Color="#E5DACB" />
    </LinearGradientBrush>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource WarlockWindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Palatino Linotype" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MutedTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource WarlockTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="SectionTitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource WarlockSoulGreenBrush}" />
    </Style>

    <Style x:Key="SectionSubtitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource WarlockGoldBrush}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource WarlockAbyssBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockArcanePurpleBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Background" Value="#E8DCC8" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockBorderBrush}" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#F5E6E6" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockDangerBrush}" />
    </Style>

    <Style x:Key="SoulAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#E2F0E6" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockSoulGreenBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource WarlockAbyssBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="CaretBrush" Value="{StaticResource WarlockSoulGreenBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource WarlockArcanePurpleBrush}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource WarlockAbyssBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource WarlockAbyssBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource WarlockSelectionBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource WarlockAbyssBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource WarlockAbyssBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="{StaticResource WarlockRowBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource WarlockAbyssBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource WarlockRowBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource WarlockRowAltBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="HeadersVisibility" Value="Column" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource WarlockHeaderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource WarlockGoldBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource WarlockRowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource WarlockSelectionBrush}" />
                <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource WarlockTextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalFirst" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="0,18,0,18" />
        <Setter Property="Background" Value="{StaticResource WarlockBorderBrush}" />
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarlockCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarlockBorderBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="StatCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Background" Value="{StaticResource WarlockCardAltBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="ImagePreviewBorderStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="#EFE5D5" />
    </Style>

    <Style x:Key="StatValueTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource WarlockSoulGreenBrush}" />
    </Style>
</ResourceDictionary>
