<Window x:Class="LifeRPG.App.ShortcutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键设置" Height="380" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#181825">
    <Window.Resources>
        <Style TargetType="TextBox" x:Key="KeyCaptureBox">
            <Setter Property="Width" Value="180" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#1E1E2E" />
            <Setter Property="Foreground" Value="#A6E3A1" />
            <Setter Property="BorderBrush" Value="#45475A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="Button" x:Key="DialogButton">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="#313244" />
            <Setter Property="Foreground" Value="#CDD6F4" />
            <Setter Property="BorderBrush" Value="#45475A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="Button" x:Key="DialogButtonSave" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#3A2552" />
            <Setter Property="BorderBrush" Value="#A6E3A1" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="#45475A" BorderThickness="1" Margin="0">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="快捷键设置" FontSize="18" FontWeight="Bold"
                           Foreground="#CDD6F4" Margin="0,0,0,4" />
                <TextBlock Text="点击输入框后按下组合键（如 Ctrl+Shift+K）" FontSize="13"
                           Foreground="#A6ADC8" Margin="0,0,0,16" />
            </StackPanel>

            <ItemsControl Grid.Row="1" x:Name="ShortcutsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       Foreground="#CDD6F4" FontSize="14" />
                            <Border Grid.Column="2" Background="#1E1E2E" BorderBrush="#45475A"
                                    BorderThickness="1" CornerRadius="4" Padding="4,0">
                                <TextBox x:Name="CaptureBox" Text="{Binding DisplayText, Mode=OneWay}"
                                         Background="Transparent" Foreground="#A6E3A1"
                                         BorderThickness="0" FontSize="14" FontWeight="Bold"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Height="30"
                                         PreviewKeyDown="KeyCaptureBox_PreviewKeyDown" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource DialogButton}" Content="默认" Click="ResetDefaultsButton_Click" />
                <Button Margin="10,0,0,0" Style="{StaticResource DialogButtonSave}" Content="保存" Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
